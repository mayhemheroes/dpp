"\"mention_channels\":"
"\"member\":"
"\"embeds\":"
"\"components\":"
"\"attachments\":"
"\"reactions\":"
"\"sticker_items\":"
"\"stickers\":"
"\"message_reference\":"
"\"referenced_message\":"
"\"interaction\":"
"\"poll\":"
"\"resolved\":"

