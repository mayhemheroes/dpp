# libFuzzer dictionary for DPP's Discord event-payload JSON parser.
# JSON structural tokens + the Discord field keys DPP's fill_from_json routines look up.

# --- JSON structure ---
"{"
"}"
"["
"]"
":"
","
"\"\""
"true"
"false"
"null"
"0"
"\"0\""
"1.0"
"-1"

